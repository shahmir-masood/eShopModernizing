@{
    ViewBag.Title = "About";
}

<section class="esh-about">
    <div class="container esh-about-container">
        <h2 class="esh-about-title">About</h2>
        <div class="esh-about-content">
            <h3 class="esh-about-subtitle">Our Mission</h3>
            <p class="esh-about-text">
                Cognition is an applied AI lab building AI teammates, starting with Devin, the first AI software engineer.
            </p>
            <p class="esh-about-text">
                We believe that the power of AI, when used correctly, can unlock the potential of engineers and entire
                engineering organizations by enabling them to focus on more interesting problems, unlock new possibilities,
                and accelerate the pace of building. Our mission is to build collaborative AI teammates that reason,
                learn, and work alongside human engineers to turn ideas into reality.
            </p>
            <p class="esh-about-text">
                By combining advances in long-horizon reasoning with real-world software engineering capabilities,
                Cognition is pioneering a future where humans and AI work together to build extraordinary things.
            </p>
        </div>
    </div>
</section>
