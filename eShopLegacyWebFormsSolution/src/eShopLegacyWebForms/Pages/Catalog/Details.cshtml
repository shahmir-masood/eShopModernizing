@page "{id:int}"
@model eShopLegacyWebForms.Pages.Catalog.DetailsModel
@{
    ViewData["Title"] = "Details";
    var product = Model.Product;
}

<h2 class="esh-body-title">Details</h2>

<div class="container">
    <div class="row">
        <img class="col-md-6 esh-picture" src="~/Pics/@product.PictureFileName" />
        <dl class="col-md-6 dl-horizontal">
            <dt>Name</dt>
            <dd>@product.Name</dd>

            <dt>Description</dt>
            <dd>@product.Description</dd>

            <dt>Brand</dt>
            <dd>@product.CatalogBrand?.Brand</dd>

            <dt>Type</dt>
            <dd>@product.CatalogType?.Type</dd>

            <dt>Price</dt>
            <dd><span class="esh-price">@product.Price</span></dd>

            <dt>Picture name</dt>
            <dd>@product.PictureFileName</dd>

            <dt>Stock</dt>
            <dd>@product.AvailableStock</dd>

            <dt>Restock</dt>
            <dd>@product.RestockThreshold</dd>

            <dt>Max stock</dt>
            <dd>@product.MaxStockThreshold</dd>
        </dl>
    </div>

    <div class="form-actions no-color esh-link-list">
        <a asp-page="/Catalog/Edit" asp-route-id="@product.Id" class="esh-link-item">Edit</a>
        |
        <a asp-page="/Index" class="esh-link-item">Back to list</a>
    </div>
</div>
