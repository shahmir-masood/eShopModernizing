<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>eShopWCFService</RootNamespace>
    <AssemblyName>eShopWCFService</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CoreWCF.Primitives" Version="1.5.2" />
    <PackageReference Include="CoreWCF.Http" Version="1.5.2" />
    <PackageReference Include="EntityFramework" Version="6.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Client-side proxy stub; not part of the service host and does not
         implement the current ICatalogService contract. -->
    <Compile Remove="CatalogServiceClient.cs" />
  </ItemGroup>

</Project>
