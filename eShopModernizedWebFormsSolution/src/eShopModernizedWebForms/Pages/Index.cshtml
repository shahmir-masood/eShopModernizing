@page
@model eShopModernizedWebForms.Pages.IndexModel
@{
    ViewData["Title"] = "Home Page";
    var data = Model.CatalogModel;
}

<div class="esh-table">
    <p class="esh-link-wrapper">
        <a asp-page="/Catalog/Create" class="btn esh-button esh-button-primary">
            Create New
        </a>
    </p>

    @if (data == null || !data.Data.Any())
    {
        <table>
            <tr>
                <td>No data was returned.</td>
            </tr>
        </table>
    }
    else
    {
        <table class="table">
            <thead>
                <tr class="esh-table-header">
                    <th></th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Brand</th>
                    <th>Type</th>
                    <th>Price</th>
                    <th>Picture name</th>
                    <th>Stock</th>
                    <th>Restock</th>
                    <th>Max stock</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in data.Data)
                {
                    <tr>
                        <td><img class="esh-thumbnail" src="@item.PictureUri" /></td>
                        <td><p>@item.Name</p></td>
                        <td><p>@item.Description</p></td>
                        <td><p>@item.CatalogBrand?.Brand</p></td>
                        <td><p>@item.CatalogType?.Type</p></td>
                        <td><p><span class="esh-price">@item.Price</span></p></td>
                        <td><p>@item.PictureFileName</p></td>
                        <td><p>@item.AvailableStock</p></td>
                        <td><p>@item.RestockThreshold</p></td>
                        <td><p>@item.MaxStockThreshold</p></td>
                        <td>
                            <a asp-page="/Catalog/Edit" asp-route-id="@item.Id" class="esh-table-link">Edit</a>
                            |
                            <a asp-page="/Catalog/Details" asp-route-id="@item.Id" class="esh-table-link">Details</a>
                            |
                            <a asp-page="/Catalog/Delete" asp-route-id="@item.Id" class="esh-table-link">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (data != null)
{
    <div class="esh-pager">
        <div class="container">
            <article class="esh-pager-wrapper row">
                <nav>
                    <a asp-page="/Index" asp-route-index="@(data.ActualPage - 1)" asp-route-size="@data.ItemsPerPage"
                       class="esh-pager-item esh-pager-item--navigable@(data.ActualPage > 0 ? "" : " esh-pager-item--hidden")">
                        Previous
                    </a>

                    <span class="esh-pager-item">
                        Showing @data.ItemsPerPage of @data.TotalItems products - Page @(data.ActualPage + 1) - @data.TotalPages
                    </span>

                    <a asp-page="/Index" asp-route-index="@(data.ActualPage + 1)" asp-route-size="@data.ItemsPerPage"
                       class="esh-pager-item esh-pager-item--navigable@(data.ActualPage < data.TotalPages - 1 ? "" : " esh-pager-item--hidden")">
                        Next
                    </a>
                </nav>
            </article>
        </div>
    </div>
}
