@page "{id:int}"
@model eShopModernizedWebForms.Pages.Catalog.EditModel
@{
    ViewData["Title"] = "Edit";
}

<h2 class="esh-body-title">Edit</h2>

<div class="container">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Input.PictureFileName" />
        <div class="row">
            <div class="col-md-4">
                <img class="esh-picture" src="@Model.PictureUri" />

                @if (Model.ShowUpload)
                {
                    <div id="UploadButton" class="row">
                        <div class="col-md-6">
                            <label class="btn btn-default esh-button-upload">
                                Upload image
                                <input type="file" id="uploadEditorImage" accept="image/*" class="hidden" />
                            </label>
                            <input type="hidden" asp-for="Input.TempImageName" id="TempImageName" />
                        </div>
                        <div class="esh-loader col-md-3 hidden"></div>
                        <div class="col-md-6">
                            <span class="text-danger field-validation-error" id="img-validation-error"></span>
                        </div>
                    </div>
                }
            </div>
            <div class="col-md-8 form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-4">Name</label>
                    <div class="col-md-8">
                        <input asp-for="Input.Name" class="form-control" />
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Description</label>
                    <div class="col-md-8">
                        <input asp-for="Input.Description" class="form-control" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Brand</label>
                    <div class="col-md-8">
                        <select asp-for="Input.CatalogBrandId" asp-items="Model.Brands" class="form-control"></select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Type</label>
                    <div class="col-md-8">
                        <select asp-for="Input.CatalogTypeId" asp-items="Model.Types" class="form-control"></select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Price</label>
                    <div class="col-md-8">
                        <input asp-for="Input.Price" class="form-control" />
                        <span asp-validation-for="Input.Price" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Picture name</label>
                    <div class="col-md-8">
                        <input value="@Model.Input.PictureFileName" readonly title="Not allowed for edition" class="form-control" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Stock</label>
                    <div class="col-md-8">
                        <input asp-for="Input.AvailableStock" class="form-control" />
                        <span asp-validation-for="Input.AvailableStock" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Restock</label>
                    <div class="col-md-8">
                        <input asp-for="Input.RestockThreshold" class="form-control" />
                        <span asp-validation-for="Input.RestockThreshold" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Max stock</label>
                    <div class="col-md-8">
                        <input asp-for="Input.MaxStockThreshold" class="form-control" />
                        <span asp-validation-for="Input.MaxStockThreshold" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-12 text-right esh-button-actions">
                        <a href="~/" class="btn esh-button esh-button-secondary">[ Cancel ]</a>
                        <button type="submit" class="btn esh-button esh-button-primary">[ Save ]</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
